# Nashville Campus Radar — environment template
# Copy to `.env` in the repo root (that single file is loaded by Bun and Vite for
# every package). Never commit `.env` — it is gitignored.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
WEBSITE_URL=http://localhost:4200
APPLICATION_ID=nashville-campus-radar

# ---- Database (Turso / libSQL) -------------------------------------------
# Local file DB works too: DATABASE_URL=file:./local.db  (leave the token empty)
DATABASE_URL=libsql://<your-database>.turso.io
DATABASE_AUTH_TOKEN=

# ---- AI gateway (event extraction) ---------------------------------------
# Any OpenAI-compatible gateway supported by the Vercel AI SDK `createGateway`.
# The pipeline calls the model id `google/gemini-3-flash`.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ---- Admin wall ----------------------------------------------------------
# Every procedure that spends AI credits (scraping, extraction, publishing)
# requires this key. If it is unset the app fails closed: nobody can spend.
ADMIN_KEY=

# ---- Optional template modules (unused by the core app) ------------------
BETTER_AUTH_SECRET=
AUTUMN_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Browser-exposed values (VITE_ prefix = shipped to the client) --------
VITE_APPLICATION_ID=nashville-campus-radar
